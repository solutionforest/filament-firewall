{
    "name": "solution-forest/filament-firewall",
    "description": "This is a middleware for whitelisting/blacklisting for Filament Admin",
    "keywords": [
        "Solution Forest",
        "laravel",
        "filament-firewall"
    ],
    "homepage": "https://github.com/solution-forest/filament-firewall",
    "support": {
        "issues": "https://github.com/solution-forest/filament-firewall/issues",
        "source": "https://github.com/solution-forest/filament-firewall"
    },
    "license": "MIT",
    "authors": [{
        "name": "Carly",
        "email": "info@solutionforest.net",
        "role": "Developer"
    }],
    "require": {
        "php": "^8.0",
        "akaunting/laravel-firewall": ">=2.0",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "SolutionForest\\FilamentFirewall\\": "src",
            "SolutionForest\\FilamentFirewall\\Database\\Factories\\": "database/factories",
            "SolutionForest\\FilamentFirewall\\Database\\Seeders\\": "database/seeders"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolutionForest\\FilamentFirewall\\Tests\\": "tests/src"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolutionForest\\FilamentFirewall\\FilamentFirewallServiceProvider"
            ],
            "aliases": {
                "FilamentFirewall": "SolutionForest\\FilamentFirewall\\Facades\\FilamentFirewall"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
